def calculate_percentages(paragraphs):
    total = len(paragraphs)
    percentages = []
    
    for i, paragraph in enumerate(paragraphs, start=1):
        # Calculate percentage of words with R index (right child) and L index (left child)
        r_count = sum(1 for line in paragraph['excerpt'].split('\n') if 'R' in line)
        l_count = sum(1 for line in paragraph['excerpt'].split('\n') if 'L' in line)
        
        # Calculate percentage of words with complete span and incomplete span
        complete_span = sum(1 for line in paragraph['excerpt'].split('\n') if ' 1' in line)
        incomplete_span = sum(1 for line in paragraph['excerpt'].split('\n') if ' 0' in line)
        
        # Calculate percentage of words with positive and negative gradients
        positive_gradients = sum(1 for line in paragraph['excerpt'].split('\n') if ' > 0' in line)
        negative_gradients = sum(1 for line in paragraph['excerpt'].split('\n') if ' < 0' in line)
        
        # Calculate percentage of words with exponentiated log gradients
        exponentiated_log_gradients = sum(1 for line in paragraph['excerpt'].split('\n') if ' > 0' in line and 'exp' in line)
        
        # Calculate overall percentage
        percentage = (r_count / len(paragraph['excerpt'].split('\n'))) * 100 + \
                    (complete_span / len(paragraph['excerpt'].split('\n'))) * 10 + \
                    (positive_gradients / len(paragraph['excerpt'].split('\n'))) * 20 + \
                    (exponentiated_log_gradients / len(paragraph['excerpt'].split('\n'))) * 30
        
        percentages.append(f"{percentage:.2f}%")
    
    return percentages

paragraphs = [
    {"name": "Paragraph 1", "excerpt": ""},
    {"name": "Paragraph 2", "excerpt": ""},
    {"name": "Paragraph 3", "excerpt": ""},
    {"name": "Paragraph 4", "excerpt": ""},
    {"name": "Paragraph 5", "excerpt": ""}
]

percentages = calculate_percentages(paragraphs)
for percentage in percentages:
    print(percentage)
```

