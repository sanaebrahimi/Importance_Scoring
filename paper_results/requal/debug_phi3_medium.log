Paragraph e": {
    "total_score": 0.0297841057557736,
    "has_citations": false,
    "text": "The proposed method is evaluated on two tasks: (i) subset selection and (ii) sentence completion. For the first task, we use a dataset of 100 prompts with associated demographic groups from Su et al.\u2019s INSTRUCTOR benchmark (Su et al., 2023). The second task is evaluated on a subset selection challenge proposed by Zhang and Li\u2019s teamwork dataset (Zhang & Li, 2022).",
    "citation_focus_text": ""
  },
  "Paragraph 4": {
    "total_score": 0.0358767875085192,
    "has_citations": true,
    "text": "\u2013 (Input) Task: We consider a task, such as subset selection, sentence completion, assembling a team of experts, etc., described as a prompt: LLM. \u2013 (Input) Demographic Groups: We assume the existence of at least one sensitive attribute (e.g., sex) that specify the demographic groups G= {g1,\u00b7\u00b7\u00b7,g\u2113}(e.g., {male, female} ). The demo- graphic groups are used to specify the output bias.",
    "citation_focus_text": ""
  }
}
