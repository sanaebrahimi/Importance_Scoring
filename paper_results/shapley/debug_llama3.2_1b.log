consumed_segments = []
summary_segments = []

for segment_id, segment in child_segments.items():
    if segment["name"] == "Paragraph 1":
        new_knowledge = True
        for paragraph in ["Paragraph 2", "Paragraph 3", "Paragraph 4", "Paragraph 5"]:
            if paragraph["excerpt"].startswith("Definition"):
                new_knowledge = False
                break
        if new_knowledge:
            new_paragraphs.append(segment_id)
    elif segment["name"] == "Paragraph 2":
        consumed_segments.append(segment_id)
    elif segment["name"] == "Paragraph 3":
        summary_segments.append(segment_id)
    elif segment["name"] == "Paragraph 4":
        consumed_segments.append(segment_id)
    elif segment["name"] == "Paragraph 5":
        new_paragraphs.append(segment_id)

total_consumed = len(consumed_segments)
total_new = len(new_paragraphs) - total_consumed

percentage_new = (total_new / child_segments["1"]["name"]) * parent_score
percentage_consumed = (total_consumed / child_segments["1"]["name"]) * parent_score

print(f"{new_paragraphs[0]}: {percentage_new:.2f}")
for segment_id in consumed_segments:
    print(f"{segment_id}: {percentage_consumed:.2f}")
