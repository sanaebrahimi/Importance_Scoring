def calculate_citation_percentage(text):
    """
    Calculate the citation percentage for a given text.
    
    Args:
        text (str): The input text to analyze
    
    Returns:
        float: Citation percentage (0-100)
    """
    # Count citation markers (e.g., [51], [123])
    citation_count = text.count('[') + text.count(']')  # Simple heuristic
    
    # Calculate percentage (using total characters for simplicity)
    total_chars = len(text)
    if total_chars == 0:
        return 0.0
    
    # Return percentage (0-100)
    return (citation_count / total_chars) * 100

# Example usage
if __name__ == "__main__":
    # User should replace this with their actual text
    sample_text = "Budget-aware algorithm for ε-nets: We introduce a budget-aware algorithm that allows the user to control a resource budget. Given a timing budget B, the algorithm achieves success with probability depending on B. This approach is inspired by the Net-Finder algorithm [51]."
    
    citation_percentage = calculate_citation_percentage(sample_text)
    print(f"Citation percentage: {citation_percentage:.2f}%")
```

