def calculate_percentages(children):
    total = 100
    percentages = []
    for i, child in enumerate(children):
        percentage = (childs[i] / total) * 100
        parent.append(str(round(percentage))
    return "Parent: {parent_name} - <id>: {percentage}%\n"
