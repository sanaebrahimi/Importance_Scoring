Here's the program:

```python
import re
import sys

def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        
        # Check for citation markers (e.g., [1], [2], etc.)
        if re.search(r'\[\d+\]', line):
            print(f"Technical percentage: 20%")
            print(f"Citation percentage: 80%")
        else:
            print(f"Technical percentage: 100%")
            print(f"Citation percentage: 0%")

if __name__ == "__main__":
    main()
```

