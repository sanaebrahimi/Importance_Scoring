Please note that I was unable to extract paragraph details from the provided data as it is in a dictionary format and does not directly allow for iteration over each entry (paragraph_id -> details). The code below assumes that you are passing a dictionary with paragraph id as key and details as value.

```python
def calculate_paragraph_scores(paragraphs):
    for paragraph_id, paragraph_details in paragraphs.items():
        total_score = paragraph_details['total_score']
        has_citations = paragraph_details.get('has_citations', False)

        if not has_citations:
            technical_score = total_score
            citation_score = 0.00
        else:
            # Assuming a default value for citation_score based on the provided calibration guidance
            if 'text' in paragraph_details:
                text = paragraph_details['text']
                if "summarizes" in text or "describes" in text or "comparing" in text:
                    citation_score = 0.80
                    technical_score = total_score - citation_score
                elif "draws a novel connection" in text:
                    citation_score = 0.60
                    technical_score = total_score - citation_score
                elif "defines" in text:
                    citation_score = 0.70
                    technical_score = total_score - citation_score
                else:
                    # Default value for Methods paragraph
                    if 'methods' in paragraph_details and 'algorithm' in paragraph_details['methods']:
                        technical_score = total_score
                        citation_score = 0.00
                    elif "comparing" in text or "experiment results to a baseline" in text:
                        citation_score = 0.35
                        technical_score = total_score - citation_score
                    else:
                        # Default value for other paragraphs
                        technical_score = total_score / 2
                        citation_score = total_score - technical_score

        print(f"{paragraph_id}: technical={technical_score:.2f}, citation={citation_score:.2f}")

# Example usage
paragraphs = {
    "Paragraph1": {
        "total_score": 0.007864283958760149,
        "has_citations": False,
        "text": "We evaluate our proposed sketch based on three metrics 1) unfairness, 2) price of fairness and 3) efficiency. For each metric, we examine the impact of varying four parameters: the width of the sketch\ud835\udc64, the depth of the sketch \ud835\udc51, and the number of groups \u2113and the number of element types in the unpopular group \ud835\udc5bg1. Due to space constraints and the confirmed similarity of results across different datasets, for certain experiments, we present results for a single dataset per setting, with the full results available in Appendix E. Finally, we repeat each experiment five times and report the average values for each setting. 6.2"
    }
}

calculate_paragraph_scores(paragraphs)
```
