# Function to find recipes based on cuisine type
def find_recipes(cuisine_type):
    if cuisine_type in cuisine_keywords:
        return [f"{keyword}-based {cuisine_type} dish" for keyword in cuisine_keywords[cuisine_type]]
    else:
        return ["No recipes found for the specified cuisine."]

# Displaying the results
recipes = find_recipes(cuisine_type)
for i, recipe in enumerate(recipes, 1):
    print(f"Recipe {i}: {recipe}")
