def parse_parent_child_structure(s):
    parent_child_dict = {}
    for line in s.strip().split('\n'):
        line = line.strip()
        if line:
            # Split the line into parts by comma
            parts = [part.strip() for part in line.split(',')]
            # Each part should be like "Parent: X" and "Child: Y"
            parent_part = parts[0]
            child_part = parts[1]
            # Split by colon to get key and value
            parent_key, parent_value = parent_part.split(':')
            child_key, child_value = child_part.split(':')
            parent = parent_value.strip()
            child = child_value.strip()
            if parent not in parent_child_dict:
                parent_child_dict[parent] = []
            parent_child_dict[parent].append(child)
    return parent_child_dict
```

